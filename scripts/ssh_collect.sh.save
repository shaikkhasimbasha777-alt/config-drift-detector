#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

SERVERS_FILE="$PROJECT_DIR/servers.txt"
OUTPUT="$PROJECT_DIR/ssh-collected"

mkdir -p "$OUTPUT"

while read -r server_name host; do

    echo "====================================="
    echo "Collecting from: $server_name"
    echo "Host: $host"
    echo "====================================="

        net.ipv4.conf.all.accept_redirects \
        net.ipv4.conf.all.send_redirects" \
        > "$OUTPUT/${server_name}_sysctl.conf"

    if [ $? -eq 0 ]; then
        echo "Sysctl config: SUCCESS"
    else
        echo "Sysctl config: FAILED"
    fi

    # 3. Firewall configuration
    ssh "$host" '
        if command -v nft >/dev/null 2>&1; then
            sudo nft list ruleset
        elif command -v iptables-save >/dev/null 2>&1; then
            sudo iptables-save
        else
            echo "FIREWALL_UNAVAILABLE"
            exit 2
        fi
    ' > "$OUTPUT/${server_name}_firewall.rules"

    if grep -q "FIREWALL_UNAVAILABLE" "$OUTPUT/${server_name}_firewall.rules"; then
        echo "Firewall config: UNAVAILABLE"
    elif [ $? -eq 0 ]; then
        echo "Firewall config: SUCCESS"
    else
        echo "Firewall config: FAILED"
    fi

    echo

done < "$SERVERS_FILE"

echo "====================================="
echo "Collection complete."
echo "====================================="
